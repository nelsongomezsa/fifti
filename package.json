{
  "name": "fifti",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit",
    "test:rls": "vitest run tests/rls",
    "icons": "node scripts/build-logo.mjs && node scripts/generate-icons.mjs",
    "audit": "npm audit --audit-level=moderate",
    "build:ci": "node scripts/copy-ocr-assets.mjs && NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321 NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-for-build-only next build",
    "check": "npm run typecheck && npm run lint && npm test && npm run build:ci",
    "prebuild": "node scripts/copy-ocr-assets.mjs",
    "predev": "node scripts/copy-ocr-assets.mjs",
    "smoke": "node scripts/smoke.mjs",
    "e2e:sheet": "node scripts/e2e/sheet-fits.mjs",
    "e2e:nuevo": "node scripts/e2e/quick-new.mjs",
    "e2e:overflow": "node scripts/e2e/overflow.mjs",
    "e2e:parity": "node scripts/e2e/parity.mjs",
    "predeploy": "npm run check && npx playwright test e2e/routes.spec.ts --project=movil",
    "deploy": "npm run predeploy && npx vercel deploy --prod --yes && npm run smoke"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.2",
    "@tesseract.js-data/spa": "^1.0.0",
    "d3-hierarchy": "^3.1.3",
    "lucide-react": "^1.78.0",
    "next": "^16.4.6",
    "next-intl": "^4.15.3",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.0",
    "server-only": "^0.0.1",
    "tesseract.js": "^7.0.0",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@fontsource/space-grotesk": "^5.3.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.6",
    "fake-indexeddb": "^6.2.8",
    "opentype.js": "^2.0.0",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.18.1",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  },
  "type": "module",
  "license": "MIT"
}
